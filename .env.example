# VeriFeed Environment Variables Template

# AI Provider (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://verifeed_user:verifeed_password@localhost:5433/verifeed_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend API
API_V1_STR=/api/v1
PROJECT_NAME=VeriFeed
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
